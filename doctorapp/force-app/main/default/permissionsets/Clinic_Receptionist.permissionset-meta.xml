<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets a clinic receptionist read, book and delete appointments on the Appointments tab.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Clinic Receptionist</label>

    <classAccesses><apexClass>ScheduleController</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleDao</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleAssistantController</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleAssistantService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleSlotFinder</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>ScheduleValidator</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>APIResponse</apexClass><enabled>true</enabled></classAccesses>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Schedule__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!--
        Universally-required fields are deliberately absent from this list:
        StartDateTime__c, FirstName__c, LastName__c, PhoneNumber__c, Type__c,
        DurationMinutes__c and Fees__c all carry <required>true</required> in
        their field metadata. Salesforce rejects a fieldPermissions entry for a
        required field ("You cannot deploy to a required field") because such a
        field is always readable and editable to anyone with object access —
        listing it is both redundant and a deploy failure.
    -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Schedule__c.EndDateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Schedule__c.PhoneNumber2__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Schedule__c.Location__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Schedule__c.Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <tabSettings>
        <tab>ManageAppointmentList</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
