<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Refund</fullName>
    <active>true</active>
    <description>Refund amount cannot be negative.</description>
    <errorConditionFormula>Refund_Amount__c &lt; 0</errorConditionFormula>
    <errorMessage>Refund Amount cannot be negative.</errorMessage>
    <errorDisplayField>Refund_Amount__c</errorDisplayField>
</ValidationRule>
