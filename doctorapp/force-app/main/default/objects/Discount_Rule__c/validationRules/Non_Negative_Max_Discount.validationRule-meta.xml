<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Max_Discount</fullName>
    <active>true</active>
    <description>The discount cap cannot be negative.</description>
    <errorConditionFormula>NOT(ISBLANK(Max_Discount__c)) &amp;&amp; Max_Discount__c &lt; 0</errorConditionFormula>
    <errorMessage>Max Discount cannot be negative.</errorMessage>
    <errorDisplayField>Max_Discount__c</errorDisplayField>
</ValidationRule>
