<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Points_Not_Zero</fullName>
    <active>true</active>
    <description>A log entry must move the balance.</description>
    <errorConditionFormula>Points__c = 0</errorConditionFormula>
    <errorMessage>Points cannot be zero.</errorMessage>
    <errorDisplayField>Points__c</errorDisplayField>
</ValidationRule>
