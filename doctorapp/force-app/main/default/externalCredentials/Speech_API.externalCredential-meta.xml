<?xml version="1.0" encoding="UTF-8"?>
<!--
    Auth for the speech provider. Custom protocol: after deploying, open
    Setup → Named Credentials → External Credentials → Speech API, edit the
    "SpeechPrincipal" principal and add the provider's API key as a custom
    header (for Google, header name `X-Goog-Api-Key`).

    No secret is stored in this repository.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <label>Speech API</label>
    <externalCredentialParameters>
        <parameterName>SpeechPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
